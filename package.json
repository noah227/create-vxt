{
    "name": "create-vxt",
    "version": "0.0.0",
    "description": "create vue based browser extension",
    "keywords": [
        "chrome",
        "edge",
        "vue",
        "vite",
        "extension",
        "cli"
    ],
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "build-watch": "vite build --watch",
        "type-check": "vue-tsc --build",
        "build-cli": "rolldown -c vite.cli.config.ts",
        "include-files": "tsx cli/include.ts"
    },
    "bin": {
        "create-vxt": "cli-dist/index.js"
    },
    "files": [
        ".vscode/extensions.json",
        "public",
        "src",
        ".editorconfig",
        "env.d.ts",
        "tsconfig.app.json",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "vxt.config.ts",
        "cli-dist",
        "_gitignore",
        "package.json",
        "README.md",
        "README.template.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/noah227/create-vxt.git"
    },
    "license": "MIT",
    "dependencies": {
        "vue": "^3.5.32"
    },
    "devDependencies": {
        "@clack/prompts": "^1.4.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.12.4",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/tsconfig": "^0.9.1",
        "npm-run-all2": "^8.0.4",
        "picocolors": "^1.1.1",
        "sass-embedded": "^1.99.0",
        "tsx": "^4.22.0",
        "typescript": "~6.0.0",
        "vite": "^8.0.8",
        "vite-plugin-static-copy": "^4.1.0",
        "vite-plugin-vue-devtools": "^8.1.1",
        "vue-tsc": "^3.2.6"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}